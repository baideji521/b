{
  "paths": {
    "input_dir": "input",
    "output_dir": "output",
    "cache_dir": "cache",
    "log_dir": "logs",
    "model_dir": "models"
  },
  "visual": {
    "model_id": "Qwen/Qwen3-VL-4B-Instruct",
    "fallback_model_ids": [
      "Qwen/Qwen3-VL-2B-Instruct"
    ],
    "backend": "auto",
    "models": [
      {
        "label": "Qwen3-VL-4B-Instruct (默认)",
        "model_id": "Qwen/Qwen3-VL-4B-Instruct",
        "backend": "qwen3vl"
      },
      {
        "label": "Qwen3-VL-2B-Instruct (更省显存)",
        "model_id": "Qwen/Qwen3-VL-2B-Instruct",
        "backend": "qwen3vl"
      },
      {
        "label": "MiniCPM-V-4.5 int4 (8.7B/4bit)",
        "model_id": "openbmb/MiniCPM-V-4_5-int4",
        "backend": "minicpm"
      },
      {
        "label": "MiniCPM-V-4.6 (1.3B/BF16, 隔离依赖 tf57)",
        "model_id": "openbmb/MiniCPM-V-4.6",
        "backend": "minicpm46"
      },
      {
        "label": "Qwen3-VL-8B-Instruct nf4 (动作识别更强，bnb 4bit)",
        "model_id": "Qwen/Qwen3-VL-8B-Instruct",
        "backend": "qwen3vl",
        "quantization": "nf4"
      }
    ],
    "quantization": "none",
    "minicpm": {
      "packing_nums": 1,
      "max_slice_nums": 1,
      "use_image_id": false,
      "num_beams": 1
    },
    "minicpm46": {
      "downsample_mode": "16x",
      "max_slice_nums": 1,
      "use_image_id": false,
      "stack_frames": 1,
      "dtype": "bfloat16",
      "attn_implementation": "sdpa",
      "output_format": "frame_lines"
    },
    "dtype": "bfloat16",
    "attn_implementation": "sdpa",
    "frame_source": "opencv",
    "fps": 0.75,
    "max_frames": 8,
    "min_frames": 6,
    "max_pixels_tokens": 112,
    "total_pixels_tokens": 2048,
    "max_new_tokens": 192,
    "batch_size": 8,
    "window_seconds": 15.0,
    "window_overlap_seconds": 3.0,
    "long_video_threshold": 18.0,
    "scene_detect": true,
    "scene_threshold": 0.35,
    "scene_sample_fps": 3.0,
    "snap_tolerance_seconds": 1.0,
    "min_event_seconds": 0.4,
    "max_event_seconds": 12.0,
    "merge_similarity": 0.82,
    "dedup_similarity": 0.72,
    "emotion_enabled": true,
    "face_emotion": {
      "enabled": true,
      "sample_fps": 2.0,
      "detect_size": 640,
      "detect_score": 0.6,
      "min_face_px": 60,
      "max_faces": 2,
      "min_score": 0.35
    }
  },
  "speech": {
    "model_size": "large-v3",
    "fallback_model_sizes": [
      "medium",
      "small"
    ],
    "device": "auto",
    "compute_type": "float16",
    "language": null,
    "beam_size": 5,
    "vad_filter": true,
    "word_timestamps": true,
    "condition_on_previous_text": true,
    "initial_prompt": {
      "en": "Hello, everyone! Today, we're doing a challenge. If this is pink, you have to pay. Really? Yes, of course. That's crazy!",
      "zh": "大家好，今天我们来做个挑战。如果是粉色的，你得请客。真的吗？当然是真的。太夸张了！"
    },

    "punctuation": {
      "enabled": true,
      "model_id": "iic/punc_ct-transformer_cn-en-common-vocab471067-large",
      "device": "auto"
    },
    "speaker": {
      "enabled": true,
      "model_id": "iic/speech_campplus_sv_zh-cn_16k-common",
      "models": [
        {
          "label": "中文",
          "model_id": "iic/speech_campplus_sv_zh-cn_16k-common"
        },
        {
          "label": "英文",
          "model_id": "iic/speech_campplus_sv_en_voxceleb_16k"
        }
      ],
      "device": "auto",
      "diarization": {
        "threshold": null,
        "num_threads": 4,
        "min_speaker_seconds": 2.0,
        "min_speaker_share": 0.1,
        "min_duration_on": 0.3,
        "min_duration_off": 0.5
      },
      "window_seconds": 1.0,
      "hop_seconds": 0.25,
      "min_sentences": 12,
      "max_speakers": 6,
      "min_silhouette": 0.25,
      "min_silhouette_sentence": 0.33,
      "min_cluster_share": 0.05
    },




    "emotion": {
      "enabled": true,
      "model_id": "iic/emotion2vec_plus_large",
      "fallback_model_ids": [
        "iic/emotion2vec_plus_base"
      ],
      "device": "auto",
      "batch_size": 8,
      "min_segment_seconds": 0.3,
      "top_k": 3,
      "peak_top_n": 5,
      "peak_min_intensity": 0.5
    }
  },
  "language": {
    "default_language": "zh",
    "min_language_confidence": 0.4,
    "rewrite_mismatch_with_model": true
  },
  "timeline": {
    "min_overlap_seconds": 0.2,
    "importance_filter": "low",
    "confidence_filter": 0.0
  },
  "highlight": {
    "sfx": {
      "enabled": true,
      "dir": "assets/sfx",
      "gain_db": -6.0,
      "offset_seconds": 0.0,
      "fallback_category": "punch",
      "emotion_map": {
        "happy": "funny",
        "excited": "funny",
        "surprised": "punch",
        "angry": "punch",
        "sad": "riser",
        "fearful": "riser",
        "disgusted": "fail",
        "contempt": "fail",
        "neutral": "ding",
        "calm": "ding"
      }
    }
  },
  "bridge": {
    "enabled": true,
    "port": 5998,
    "port_fallbacks": 0,

    "task_type": "gemini_json",
    "ai_url": "https://gemini.google.com/app",
    "prompt_file": "prm/prm_en.txt",
    "upload_mode": "manual",
    "keep_merged_file": false,

    "message": "Follow the rules in prm_en.txt and analyze the attached *_merged.txt. Reply with the JSON object only.",
    "auto_clip": true
  },
  "runtime": {
    "max_auto_retries": 3,
    "keep_models_loaded": true,
    "unload_speech_before_visual": true,
    "auto_clean_cache": true,
    "cache_cleanup_interval_days": 3,
    "cache_max_age_days": 3
  },
  "mirrors": {
    "pypi": [
      "https://pypi.tuna.tsinghua.edu.cn/simple",
      "https://mirrors.aliyun.com/pypi/simple",
      "https://pypi.org/simple"
    ],
    "pytorch_index": [
      "https://mirror.nju.edu.cn/pytorch/whl/cu126",
      "https://download.pytorch.org/whl/cu126"
    ],
    "pytorch_find_links": [
      "https://mirrors.aliyun.com/pytorch-wheels/cu126/"
    ],
    "hf_endpoint": "https://hf-mirror.com",
    "model_sources": [
      "modelscope",
      "hf_mirror",
      "hf"
    ],
    "modelscope_map": {
      "Qwen/Qwen3-VL-4B-Instruct": "Qwen/Qwen3-VL-4B-Instruct",
      "Qwen/Qwen3-VL-2B-Instruct": "Qwen/Qwen3-VL-2B-Instruct",
      "Qwen/Qwen3-VL-8B-Instruct": "Qwen/Qwen3-VL-8B-Instruct",
      "openbmb/MiniCPM-V-4_5-int4": "OpenBMB/MiniCPM-V-4_5-int4",
      "openbmb/MiniCPM-V-4_5": "OpenBMB/MiniCPM-V-4_5",
      "openbmb/MiniCPM-V-4.6": "OpenBMB/MiniCPM-V-4.6",
      "openbmb/MiniCPM-V-4.6-BNB": "OpenBMB/MiniCPM-V-4.6-BNB"
    },
    "whisper_sources": [
      "modelscope",
      "hf_mirror",
      "hf"
    ],
    "whisper_modelscope_map": {
      "Systran/faster-whisper-large-v3": "Systran/faster-whisper-large-v3",
      "Systran/faster-whisper-medium": "Systran/faster-whisper-medium",
      "Systran/faster-whisper-small": "Systran/faster-whisper-small"
    },
    "emotion_modelscope_map": {
      "iic/emotion2vec_plus_large": "iic/emotion2vec_plus_large",
      "iic/emotion2vec_plus_base": "iic/emotion2vec_plus_base",
      "iic/SenseVoiceSmall": "iic/SenseVoiceSmall",
      "iic/punc_ct-transformer_cn-en-common-vocab471067-large": "iic/punc_ct-transformer_cn-en-common-vocab471067-large",
      "iic/speech_campplus_sv_zh-cn_16k-common": "iic/speech_campplus_sv_zh-cn_16k-common",
      "iic/speech_campplus_sv_en_voxceleb_16k": "iic/speech_campplus_sv_en_voxceleb_16k"
    }
  }
}
