# 虚拟环境与依赖
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 模型权重（几个 GB，从 ModelScope/HF 镜像自行下载）
models/

# MiniCPM-V 4.6 专用的 transformers 5.7 依赖隔离层（几百 MB 第三方包，用脚本重建）
libs/


# 运行产物
output/
cache/
work/
logs/
# SQLite 库（缓存状态、分析结果、AI 任务）：本机数据，用 run.py db --import 重建
database/
FINAL_REPORT.txt
gui_settings.json

# 输入与测试素材
input/*
!input/.gitkeep
*.mp4
*.mov
*.mkv
*.avi
*.m4v
*.webm
*.flv
*.wmv
*.ts

# 音效库（CC0 素材，几十 MB，用 tools/fetch_sfx.py 重新下载归类）
assets/sfx/

# 工具与编辑器
.comate/
.idea/
.vscode/
Thumbs.db
desktop.ini
